# =============================================================================
#  Import/Export products — пример переменных окружения
#  Скопируй в .env:  cp .env.example .env
# =============================================================================

# ---------- Приложение ----------
# local | prod
APP_ENV=local
# 1 — показывать ошибки, 0 — нет
APP_DEBUG=1
# Публичный URL API (используется в OpenAPI: servers[].url)
APP_URL=http://localhost:8080
# Порт, на котором отвечает nginx с фронтендом и /api (совпадает с APP_PORT)
FRONTEND_PORT=8080
# Порт, на котором отвечает nginx с фронтендом
APP_PORT=8080

# ---------- PostgreSQL (сервис db) ----------
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app_secret
# Версия сервера, нужна Doctrine DBAL (не меняется вместе с образом)
DB_SERVER_VERSION=17

# ---------- Сборка образов ----------
# Зеркало Packagist на случай проблем с packagist.org (пусто = официальный)
PACKAGIST_MIRROR=

# ---------- RabbitMQ / Messenger (сервис rabbitmq) ----------
RABBITMQ_USER=app
RABBITMQ_PASSWORD=app_secret
# Порт management-UI (публикуется наружу); сам брокер слушает 5672 внутри сети
RABBITMQ_MANAGEMENT_PORT=15672

# DSN транспорта Messenger. Путь = vhost/exchange, vhost "/" кодируется как %2f.
# Он же используется для проверки /api/health
MESSENGER_TRANSPORT_DSN=amqp://app:app_secret@rabbitmq:5672/%2f/imports
# Очередь для сообщений, которые не обработались после всех попыток
MESSENGER_FAILED_TRANSPORT_DSN=amqp://app:app_secret@rabbitmq:5672/%2f/failed
# Ретраи: количество попыток и базовая задержка в мс (далее умножение на 2)
MESSENGER_RETRY_MAX_ATTEMPTS=3
MESSENGER_RETRY_DELAY_MS=1000
# Сколько ошибок подряд допускает воркер, прежде чем остановиться
MESSENGER_FAILURE_LIMIT=200

# ---------- Аутентификация ----------
# Секрет для подписи JWT. В проде обязательно заменить:
#   php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=change_me_development_secret_key_32b
# Алгоритм подписи JWT
JWT_ALGORITHM=HS256
# Время жизни токена в секундах (по умолчанию 12 часов)
JWT_TTL=43200
# Логин и пароль администратора, которого создаёт make seed
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin_secret

# ---------- Swagger UI (сервис docs) ----------
DOCS_PORT=8081

# ---------- Импорт ----------
# Максимальный размер загружаемого .xlsx (в байтах)
IMPORT_MAX_FILE_SIZE=20971520
# Разрешённые MIME-типы через запятую
IMPORT_ALLOWED_MIME=application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel.sheet.macroEnabled.12,application/zip,application/octet-stream
# Разрешённые расширения через запятую
IMPORT_ALLOWED_EXTENSIONS=xlsx,xlsm
# Таймаут скачивания одного изображения, секунды
IMPORT_IMAGE_TIMEOUT=30
# Максимум попыток скачивания картинки
IMPORT_IMAGE_RETRIES=2
# Каталог для загруженных .xlsx (общий том app и worker)
IMPORT_STORAGE_PATH=/var/www/html/storage/imports
# Сколько запросов POST /api/imports разрешено в минуту с одного IP
IMPORT_RATE_LIMIT=5

# ---------- Изображения ----------
# Внутри контейнера (том media монтируется в app, worker и frontend)
MEDIA_PATH=/var/www/media
# Публичный префикс, который отдаёт nginx
MEDIA_PUBLIC_URL=/media

# ---------- CORS ----------
# Политики CORS пока нет: фронтенд и API раздаются с одного доменного имени
# (nginx слушает APP_PORT и проксирует /api). Если фронт потребуется запускать
# на отдельном порту — см. раздел «Что ещё предстоит» в README.
